# TODO: Rewrite some scripts in another language and use the API instead of shell commands in them.

################
### MONITORS ###
################

monitor = desc:Chimei Innolux Corporation 0x1521, 1920x1080@144, 0x1080, 1
monitor = desc:Lenovo Group Limited LEN L28u-30 U1B3M25V, 3840x2160@60, 1920x0, 1
monitor = , preferred, auto, auto


###################
### MY PROGRAMS ###
###################

$terminal = kitty
$fileManager = nemo
$browser = zen-browser
$menu = pkill rofi || rofi -modes "drun" -show drun -show-icons -normal-window
$clipboardHistory = pkill rofi || selected="$(cliphist list | rofi -dmenu -i -display-columns 2)" && echo "$selected" | cliphist decode | wl-copy


#################
### AUTOSTART ###
#################

exec-once = hyprsunset
exec-once = hyprpaper

exec-once = systemctl --user start xsettingsd.service
exec-once = uwsm-app -- xembedsniproxy

exec-once = uwsm-app -- wl-paste --type text --watch cliphist store
exec-once = uwsm-app -- wl-paste --type image --watch cliphist store

exec-once = uwsm-app -- ydotoold
exec-once = uwsm-app -- udiskie
exec-once = uwsm-app -- openrgb -p reaper
exec-once = uwsm-app -- mcontrolcenter

# TODO: Replace. Temporarily copied from the old config.
exec-once = ~/.config/hypr/scripts/handle_battery.sh
exec-once = ~/.config/hypr/scripts/mute_leds.sh
exec-once = batsignal -w 15 -c 10 -d 5 -D 'notify-send --urgency=critical --icon=dialog-warning "Battery is dangerously low" "Plug in now!"'

exec-once = hyprgroups watch
exec-once = ~/Code/desktopshell/desktopshell


#############################
### ENVIRONMENT VARIABLES ###
#############################

env = HYPRSHOT_DIR,$HOME/Pictures/Screenshots/


###################
### PERMISSIONS ###
###################

# See https://wiki.hyprland.org/Configuring/Permissions/
# Please note permission changes here require a Hyprland restart and are not applied on-the-fly
# for security reasons

# ecosystem {
#   enforce_permissions = 1
# }

# permission = /usr/(bin|local/bin)/grim, screencopy, allow
# permission = /usr/(lib|libexec|lib64)/xdg-desktop-portal-hyprland, screencopy, allow
# permission = /usr/(bin|local/bin)/hyprpm, plugin, allow


#####################
### LOOK AND FEEL ###
#####################

general {
    gaps_in = 2
    gaps_out = 5

    border_size = 2

    col.active_border = rgba(137,180,250,0.7)
    col.inactive_border = rgba(127,132,156,0.5)

    # Set to true enable resizing windows by clicking and dragging on borders and gaps
    resize_on_border = false

    # Please see https://wiki.hyprland.org/Configuring/Tearing/ before you turn this on
    allow_tearing = false

    layout = dwindle
}

decoration {
    rounding = 6
    rounding_power = 2

    # Change transparency of focused and unfocused windows
    active_opacity = 1.0
    inactive_opacity = 1.0

    border_part_of_window = false

    shadow {
        enabled = true
        range = 4
        render_power = 3
        color = rgba(1a1a1aee)
    }

    blur {
        enabled = true
        size = 2
        passes = 4

        vibrancy = 0.1696
    }
}

cursor {
    no_hardware_cursors = true
}

animations {
    enabled = yes
    # TODO: Speed up window opening and closing animations a bit (and some others)

    bezier = easeOutQuint,0.23,1,0.32,1
    bezier = easeInOutCubic,0.65,0.05,0.36,1
    bezier = linear,0,0,1,1
    bezier = almostLinear,0.5,0.5,0.75,1.0
    bezier = quick,0.15,0,0.1,1

    animation = global, 1, 10, default
    animation = border, 1, 4.79, easeOutQuint
    animation = windows, 1, 4.79, easeOutQuint
    animation = windowsIn, 1, 4.1, easeOutQuint, popin 87%
    animation = windowsOut, 1, 1.49, linear, popin 87%
    animation = fade, 1, 3.03, quick
    animation = fadeIn, 1, 1.13, almostLinear
    animation = fadeOut, 1, 1.46, almostLinear
    animation = layers, 1, 3.81, easeOutQuint
    animation = layersIn, 1, 4, easeOutQuint, fade
    animation = layersOut, 1, 1.5, linear, fade
    animation = fadeLayersIn, 1, 1.58, almostLinear
    animation = fadeLayersOut, 1, 1.39, almostLinear
    animation = workspaces, 1, 1.58, almostLinear, fade
    animation = workspacesIn, 1, 1.21, almostLinear, fade
}

# "Smart gaps" / "No gaps when only"
# uncomment all if you wish to use that.
# workspace = w[tv1], gapsout:0, gapsin:0
# workspace = f[1], gapsout:0, gapsin:0
# windowrule = border_size 0, rounding 0, match:float 0, match:workspace w[tv1]
# windowrule = border_size 0, rounding 0, match:float 0, match:workspace f[1]

dwindle {
    pseudotile = true # Master switch for pseudotiling. Enabling is bound to mainMod + P in the keybinds section below
    preserve_split = true # You probably want this
}

master {
    new_status = master
}

scrolling {
  fullscreen_on_one_column = true
}

misc {
    force_default_wallpaper = -1 # Set to 0 or 1 to disable the anime mascot wallpapers
    disable_hyprland_logo = false # If true disables the random hyprland logo / anime girl background. :(
}


#############
### INPUT ###
#############

input {
    kb_layout = us
    kb_variant =
    kb_model =
    kb_options =
    kb_rules =

    follow_mouse = 1

    sensitivity = 0 # -1.0 - 1.0, 0 means no modification.

    touchpad {
        natural_scroll = true
        disable_while_typing = false
    }
}

gesture = 3, horizontal, workspace


###################
### KEYBINDINGS ###
###################

bind = SUPER, Return, exec, uwsm-app -- "$terminal"
bind = SUPER, Q, killactive,
bind = SUPER SHIFT, Q, exec, hyprctl activewindow | grep pid | tr -d 'pid:' | xargs kill
# bind = SUPER, M, exit,
bind = SUPER, E, exec, uwsm-app -- "$fileManager"
bind = SUPER, I, exec, uwsm-app -- "$browser"
bind = SUPER, V, togglefloating,
bindr = SUPER, SUPER_L, exec, $menu
bind = SUPER SHIFT, V, exec, $clipboardHistory
bind = SUPER, P, pseudo, # dwindle
bind = SUPER, J, togglesplit, # dwindle

# Move focus with mainMod + arrow keys
bind = SUPER, left, movefocus, l
bind = SUPER, right, movefocus, r
bind = SUPER, up, movefocus, u
bind = SUPER, down, movefocus, d

# Switch workspaces with mainMod + [0-9]
bind = SUPER, 1, exec, hyprgroups workspace switch -- 1
bind = SUPER, 2, exec, hyprgroups workspace switch -- 2
bind = SUPER, 3, exec, hyprgroups workspace switch -- 3
bind = SUPER, 4, exec, hyprgroups workspace switch -- 4
bind = SUPER, 5, exec, hyprgroups workspace switch -- 5
bind = SUPER, 6, exec, hyprgroups workspace switch -- 6
bind = SUPER, 7, exec, hyprgroups workspace switch -- 7
bind = SUPER, 8, exec, hyprgroups workspace switch -- 8
bind = SUPER, 9, exec, hyprgroups workspace switch -- 9
bind = SUPER, 0, exec, hyprgroups workspace switch -- 10

# Move active window to a workspace with mainMod + SHIFT + [0-9]
bind = SUPER SHIFT, 1, exec, hyprgroups workspace move -- 1
bind = SUPER SHIFT, 2, exec, hyprgroups workspace move -- 2
bind = SUPER SHIFT, 3, exec, hyprgroups workspace move -- 3
bind = SUPER SHIFT, 4, exec, hyprgroups workspace move -- 4
bind = SUPER SHIFT, 5, exec, hyprgroups workspace move -- 5
bind = SUPER SHIFT, 6, exec, hyprgroups workspace move -- 6
bind = SUPER SHIFT, 7, exec, hyprgroups workspace move -- 7
bind = SUPER SHIFT, 8, exec, hyprgroups workspace move -- 8
bind = SUPER SHIFT, 9, exec, hyprgroups workspace move -- 9
bind = SUPER SHIFT, 0, exec, hyprgroups workspace move -- 10

bind = SUPER, minus, exec, hyprgroups workspace switch -- -1
bind = SUPER, equal, exec, hyprgroups workspace switch -- +1

bind = SUPER CTRL, left, exec, hyprgroups workspace switch -- e-1
bind = SUPER CTRL, right, exec, hyprgroups workspace switch -- e+1

bind = SUPER, mouse_down, exec, hyprgroups workspace switch -- e-1
bind = SUPER, mouse_up, exec, hyprgroups workspace switch -- e+1

bind = SUPER SHIFT, minus, exec, hyprgroups workspace move -- -1
bind = SUPER SHIFT, equal, exec, hyprgroups workspace move -- +1

bind = SUPER CTRL SHIFT, left, exec, hyprgroups workspace move -- e-1
bind = SUPER CTRL SHIFT, right, exec, hyprgroups workspace move -- e+1

bind = SUPER SHIFT, mouse_down, exec, hyprgroups workspace move -- e-1
bind = SUPER SHIFT, mouse_up, exec, hyprgroups workspace move -- e+1

bind = SUPER, G, exec, pkill rofi || hyprgroups group list | rofi -dmenu -i -on-entry-accepted "hyprgroups group switch -- '{entry}'"
bind = SUPER SHIFT, G, exec, pkill rofi || ~/.config/hypr/scripts/hyprgroups-substitute-menu.sh

# bind = SUPER, C, movetoworkspace, special
bind = SUPER, C, exec, ~/.config/hypr/scripts/special_workspace.sh
bind = SUPER SHIFT, C, togglespecialworkspace,

bind = SUPER, F, fullscreen, 0
bind = SUPER SHIFT, F, fullscreen, 1

# bind = SUPER, B, exec, ~/.config/hypr/scripts/toggle_bar.sh
# bind = SUPER, B, exec, pkill desktopshell || ~/Code/desktopshell/desktopshell

# Move/resize windows with mainMod + LMB/RMB and dragging
bindm = SUPER, mouse:272, movewindow
bindm = SUPER, mouse:273, resizewindow
bindm = SUPER SHIFT, mouse:273, resizewindow 1

bind = SUPER, T, pin,
bind = SUPER, Y, tagwindow, nodim

bind = SUPER, L, exec, hyprlock

bind = SUPER SHIFT, L, submap, nobinds
submap = nobinds
bind = SUPER, L, exec, hyprlock
bind = SUPER SHIFT, U, submap, reset
submap = reset

# Laptop multimedia keys for volume and LCD brightness
bindel = , XF86AudioRaiseVolume, exec, wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindel = , XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindel = CTRL, XF86AudioRaiseVolume, exec, wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 1%+
bindel = CTRL, XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-
bindel = SHIFT, XF86AudioRaiseVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindel = SHIFT, XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindel = CTRL SHIFT, XF86AudioRaiseVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%+
bindel = CTRL SHIFT, XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-
bindel = , XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindel = , XF86AudioMicMute, exec, wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindel = , XF86MonBrightnessUp, exec, brightnessctl set 5%+
bindel = , XF86MonBrightnessDown, exec, brightnessctl set 5%-
bindel = CTRL, XF86MonBrightnessUp, exec, brightnessctl set 1%+
bindel = CTRL, XF86MonBrightnessDown, exec, brightnessctl set 1%-
bindel = SHIFT, XF86MonBrightnessUp, exec, hyprctl hyprsunset gamma +5
bindel = SHIFT, XF86MonBrightnessDown, exec, hyprctl hyprsunset gamma -5
bindel = CTRL SHIFT, XF86MonBrightnessUp, exec, hyprctl hyprsunset gamma +1
bindel = CTRL SHIFT, XF86MonBrightnessDown, exec, hyprctl hyprsunset gamma -1

# Requires playerctl
bindl = , XF86AudioNext, exec, playerctl next
bindl = , XF86AudioPause, exec, playerctl play-pause
bindl = , XF86AudioPlay, exec, playerctl play-pause
bindl = , XF86AudioPrev, exec, playerctl previous

bindl = , XF86TouchpadToggle, exec, ~/.config/hypr/scripts/touchpad.sh

# Screenshot keybindings:
bind = , Print, exec, hyprshot -m region
bind = SHIFT, Print, exec, hyprshot -m window
bind = CTRL, Print, exec, hyprshot -m output

bind = SUPER, Print, exec, hyprpicker --autocopy

bind = CTRL ALT, Delete, exec, pkill rofi || rofi -show power-menu -modi power-menu:rofi-power-menu

# bind = SUPER, O, exec, ~/Code/mc_cutting_board_macro.sh
# bind = SUPER SHIFT, O, exec, pkill -f /home/robert/Code/mc_cutting_board_macro.sh
# bind = SUPER, O, exec, ~/Code/mcbe_bundle_dupe_macro.sh
# bind = SUPER SHIFT, O, exec, pkill -f /home/robert/Code/mcbe_bundle_dupe_macro.sh

##############################
### WINDOWS AND WORKSPACES ###
##############################

# Ignore maximize requests from apps. You'll probably like this.
windowrule = suppress_event maximize, match:class .*

# Fix some dragging issues with XWayland
# windowrule = no_focus on, match:class ^$, match:title ^$, match:xwayland 1, match:float 1, match:fullscreen 0, match:pin 0

# Hide XWayland helper windows that have an empty title (common for Wine tray/menu helpers)
windowrule = match:xwayland true, match:title ^$, match:class ^$, match:initial_class ^$, match:initial_title ^$, size 0 0, opacity 0.0, float true, no_blur on

windowrule = no_dim on, match:tag nodim

layerrule = blur on, dim_around on, ignore_alpha 0, match:namespace rofi

# windowrule = float on, pin on, stay_focused on, dim_around on, keep_aspect_ratio on, match:class (wofi)

# Make games think they're being rendered when not visible.
windowrule = match:content 3, render_unfocused on

windowrule = opacity 0.90, match:class (discord|Vencord)
windowrule = opacity 0.90, match:class (Slack)
windowrule = opacity 0.80, match:class (Spotify)

windowrule = opacity 0.85, match:class (tilix)
windowrule = opacity 0.85, match:class (org.wezfurlong.wezterm)
windowrule = opacity 0.85, match:class (kitty)
windowrule = opacity 0.85, match:class (Alacritty)
windowrule = opacity 0.85, match:class (foot)

windowrule = no_dim on, match:class (firefox|zen), match:fullscreen 1
windowrule = no_blur on, no_dim on, float on, pin on, keep_aspect_ratio on, match:class (firefox|zen), match:title (Picture-in-Picture)
windowrule = opacity 1.00 1.00 override, match:class (firefox|zen), match:title ^(?!Picture-in-Picture), match:tag nodim

windowrule = tile on, match:class (Aseprite)
windowrule = tile on, match:class (Minecraft Linux Launcher UI)
windowrule = tile on, match:class (mcpelauncher-client)

windowrule = float on, match:class (yad)
